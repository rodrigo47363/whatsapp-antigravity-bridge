[Unit]
Description=WhatsApp Antigravity Bridge Daemon
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/whatsapp-antigravity-bridge
Environment="PATH=%h/.nvm/versions/node/v22.23.1/bin:%h/.gemini/antigravity-cli/bin:/usr/local/bin:/usr/bin:/bin"
Environment="DISPLAY=:0"
ExecStart=%h/whatsapp-antigravity-bridge/start_whatsapp.sh
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
